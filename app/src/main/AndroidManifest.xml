<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"


    >

    <!--    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>-->
    <!--    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>-->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/mine_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/mine"
        android:supportsRtl="true"
        android:theme="@style/Theme.MineSweeperAndroid01"
        tools:targetApi="31">
        <activity
            android:name=".views.record.RecordActivity"
            android:exported="false" />

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="@string/AMAP_api_key" />

        <!--        <service android:name="com.amap.api.location.APSService" />-->

        <activity
            android:name=".views.entrance.activities.EntranceActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".views.activities.GameActivity"
            android:exported="false"
            android:theme="@style/Theme.MineSweeperAndroid01" />
    </application>

</manifest>